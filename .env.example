# 서비스를 단독으로 실행할 때(bootRun) 쓰는 환경변수 예시. 로컬 compose 값은 docs 레포 local/.env.example에 있다.
# 사용법은 README의 "로컬 실행"을 본다. .env는 커밋하지 않는다.

# --- auth-service ---
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=auth
# 로컬 DB 컨테이너를 띄울 때 쓰는 비밀번호. 로컬에서만 쓰는 샘플값
AUTH_DB_PASSWORD=local-auth-pw
# api-gateway의 GATEWAY_JWT_ISSUER와 같아야 한다.
AUTH_JWT_ISSUER=vlm-auth-local
# 개인키를 포함한 EC P-256 JWK JSON(비밀값). ./gradlew :services:auth-service:generateSigningKey 출력을 작은따옴표로 감싸 넣는다. 새 키로 바꿔도 된다.
# 아래는 git에 공개된 로컬 전용 샘플 키다. 운영·공유 환경에서는 절대 쓰지 않는다(운영 키는 Secrets Manager).
AUTH_JWT_SIGNING_KEY='{"kty":"EC","d":"v_OXCdkCMfDjwpLAIAmEsR_V5pw6IIbFQiRwru8e0yQ","use":"sig","crv":"P-256","kid":"local-sample","x":"glBNFw9znWkVanHsx4GcfOOsVTR1DoQ3YxYMbMVCQM4","y":"hY6F69g9o3iPyc4RixkG5lKK8Xl73wDHEoHdrk-9qhE","alg":"ES256"}'
# 키 교체 중에만 쓴다. 이전 공개키 JWK Set JSON. 평소에는 비워 둔다.
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
# 초기 관리자(선택). 비우면 경고만 남기고 만들지 않는다. 비밀번호는 8~64자, 영문과 숫자 포함
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=admin1234

# --- api-gateway ---
GATEWAY_JWKS_URI=http://localhost:8081/.well-known/jwks.json
GATEWAY_JWT_ISSUER=vlm-auth-local
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
GATEWAY_REDIS_HOST=localhost
GATEWAY_REDIS_PORT=6379
# 하위 서비스 주소. 비우면 application.yml의 로컬 기본 포트를 쓴다. 아직 없는 서비스로 가는 요청은 503이다.
AUTH_SERVICE_URI=http://localhost:8081
